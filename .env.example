# Application
APP_NAME=KameArt Consent Form API
DEBUG=False
CORS_ORIGINS=["http://localhost:5173"]

# Google Drive authentication (Service Account only)
# Service Account (recomendado)
# Opcion A: JSON completo en una sola variable (ideal para Railway/Secrets)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opcion B: ruta local a archivo JSON
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
# SMTP — notificaciones por email (Gmail recomendado)
# Usa una App Password de Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=
NOTIFICATION_EMAIL=correo-del-estudio@gmail.com

# MongoDB Atlas
MONGO_URI=
MONGO_DB_NAME=
